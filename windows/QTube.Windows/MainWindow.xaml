<Window
    x:Class="QTube.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:QTube.Windows.Models"
    xmlns:vm="using:QTube.Windows.ViewModels"
    Title="QTube - Trình tải YouTube Hàng loạt"
    Width="940" Height="680"
    MinWidth="840" MinHeight="560">

    <Grid RowDefinitions="Auto,Auto,Auto,*">
        <!-- 1. App Header / Title Bar -->
        <Grid Grid.Row="0" Height="48" Padding="16,0" Background="{ThemeResource LayerFillColorDefaultBrush}" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border Width="28" Height="28" CornerRadius="6" Background="#FF0033" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE102;" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="QTube" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" />
                <TextBlock Text="v1.0.1 (Windows Native)" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0"/>
            </StackPanel>
        </Grid>

        <!-- 2. Input Box & Action Bar -->
        <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="20,16">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                <TextBox Grid.Column="0"
                         PlaceholderText="Dán link YouTube (video, danh sách phát, YouTube Mix)..."
                         Text="{x:Bind ViewModel.LinkInputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="LinkInput_KeyDown"
                         CornerRadius="6" />

                <Button Grid.Column="1" Style="{ThemeResource AccentButtonStyle}" Command="{x:Bind ViewModel.AddCurrentInputCommand}" CornerRadius="6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE109;" FontSize="13" />
                        <TextBlock Text="Thêm link" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="2" Command="{x:Bind ViewModel.PasteLinksCommand}" CornerRadius="6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE16D;" FontSize="13" />
                        <TextBlock Text="Dán từ Clipboard" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- 3. Download Options Bar -->
        <Border Grid.Row="2" Background="{ThemeResource LayerFillColorAltBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="20,10">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="14" VerticalAlignment="Center">
                <!-- Mode Selector -->
                <ComboBox Grid.Column="0" SelectedIndex="{x:Bind ViewModel.SelectedMode, Mode=TwoWay, Converter={StaticResource EnumToIntConverter}}" Width="140" CornerRadius="6">
                    <ComboBoxItem Content="Video (MP4)" />
                    <ComboBoxItem Content="Chỉ âm thanh" />
                </ComboBox>

                <!-- Video Quality -->
                <ComboBox Grid.Column="1" SelectedIndex="{x:Bind ViewModel.SelectedQuality, Mode=TwoWay, Converter={StaticResource EnumToIntConverter}}" Width="160" CornerRadius="6">
                    <ComboBoxItem Content="Tốt nhất (Gốc)" />
                    <ComboBoxItem Content="4K Ultra HD" />
                    <ComboBoxItem Content="2K Quad HD" />
                    <ComboBoxItem Content="Full HD (1080p)" />
                    <ComboBoxItem Content="HD (720p)" />
                    <ComboBoxItem Content="Tiết kiệm (480p)" />
                </ComboBox>

                <!-- Browser Cookies -->
                <ComboBox Grid.Column="2" SelectedIndex="{x:Bind ViewModel.BrowserCookieSource, Mode=TwoWay, Converter={StaticResource EnumToIntConverter}}" Width="160" CornerRadius="6">
                    <ComboBoxItem Content="Không dùng cookie" />
                    <ComboBoxItem Content="Tự động (Edge)" />
                    <ComboBoxItem Content="Microsoft Edge" />
                    <ComboBoxItem Content="Google Chrome" />
                    <ComboBoxItem Content="Brave Browser" />
                    <ComboBoxItem Content="Mozilla Firefox" />
                    <ComboBoxItem Content="Opera" />
                </ComboBox>

                <!-- Output Folder -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="Lưu tại:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Text="{x:Bind ViewModel.OutputDirectory, Mode=OneWay}" TextTrimming="CharacterEllipsis" MaxWidth="180" FontSize="12" VerticalAlignment="Center" FontWeight="Medium" />
                    <Button Click="ChooseFolder_Click" Padding="6,2" CornerRadius="4">
                        <TextBlock Text="Đổi" FontSize="11" />
                    </Button>
                </StackPanel>

                <!-- Queue Management Buttons -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8">
                    <Button Command="{x:Bind ViewModel.OpenFolderCommand}" CornerRadius="6" ToolTipService.ToolTip="Mở thư mục lưu trữ">
                        <FontIcon Glyph="&#xED25;" FontSize="14" />
                    </Button>
                    <Button Command="{x:Bind ViewModel.ClearCompletedCommand}" CornerRadius="6" ToolTipService.ToolTip="Xóa các mục đã tải xong">
                        <FontIcon Glyph="&#xE107;" FontSize="14" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 4. Main Download Queue List -->
        <Grid Grid.Row="3">
            <!-- Empty State -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12"
                        Visibility="{x:Bind ViewModel.Items.Count, Mode=OneWay, Converter={StaticResource CountToVisibilityConverter}}">
                <Border Width="64" Height="64" CornerRadius="32" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE896;" FontSize="28" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Chưa có video nào trong hàng đợi" FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Center" />
                <TextBlock Text="Copy link YouTube từ trình duyệt hoặc bấm 'Dán từ Clipboard' để bắt đầu tải" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Active List -->
            <ListView ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}" SelectionMode="None" Padding="16,12">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:DownloadItem">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
                            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                                <!-- Row 0: Title, Badge, and Action Buttons -->
                                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                    <!-- Format Badge -->
                                    <Border Grid.Column="0" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind FormatBadge}" Foreground="White" FontSize="10" FontWeight="Bold" />
                                    </Border>

                                    <!-- Title -->
                                    <TextBlock Grid.Column="1" Text="{x:Bind Title, Mode=OneWay}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />

                                    <!-- Actions -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                        <Button Click="OpenFile_Click" Visibility="{x:Bind IsCompleted, Mode=OneWay}" CornerRadius="4" Padding="8,4">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE102;" FontSize="12" />
                                                <TextBlock Text="Mở tệp" FontSize="12" />
                                            </StackPanel>
                                        </Button>
                                        <Button Click="Retry_Click" Visibility="{x:Bind IsFailed, Mode=OneWay}" CornerRadius="4" Padding="8,4">
                                            <FontIcon Glyph="&#xE149;" FontSize="12" />
                                        </Button>
                                        <Button Click="Cancel_Click" Visibility="{x:Bind IsActive, Mode=OneWay}" CornerRadius="4" Padding="8,4">
                                            <FontIcon Glyph="&#xE10A;" FontSize="12" />
                                        </Button>
                                        <Button Click="Delete_Click" CornerRadius="4" Padding="8,4">
                                            <FontIcon Glyph="&#xE107;" FontSize="12" />
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Row 1: Progress Bar -->
                                <ProgressBar Grid.Row="1" Value="{x:Bind Progress, Mode=OneWay}" Maximum="1.0" CornerRadius="2" Height="4" />

                                <!-- Row 2: Status, Speed, ETA -->
                                <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto">
                                    <TextBlock Grid.Column="0" Text="{x:Bind StatusLabel, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12">
                                        <TextBlock Text="{x:Bind FormattedSpeed, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind FormattedEta, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Window>
