<ContentDialog
    x:Class="QTube.Windows.Views.PlaylistInspectorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:QTube.Windows.Models"
    Title="Danh sách phát YouTube"
    PrimaryButtonText="Tải các mục đã chọn"
    CloseButtonText="Hủy"
    DefaultButton="Primary"
    CornerRadius="12">

    <Grid Width="560" MaxHeight="520" RowDefinitions="Auto,Auto,*">
        <!-- Playlist Header Info -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0,0,0,16">
            <Border Grid.Column="0" CornerRadius="8" Width="100" Height="60" Background="{ThemeResource SurfaceStrokeColorDefaultBrush}">
                <Image Source="{x:Bind Playlist.ThumbnailUrl, Mode=OneWay}" Stretch="UniformToFill" />
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" Spacing="4">
                <TextBlock Text="{x:Bind Playlist.Title, Mode=OneWay}" FontWeight="SemiBold" FontSize="16" TextTrimming="CharacterEllipsis" MaxLines="2" />
                <TextBlock Text="{x:Bind Playlist.Uploader, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" />
            </StackPanel>
        </Grid>

        <!-- Selection Toolbar -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <CheckBox Content="Chọn tất cả" IsChecked="{x:Bind SelectAll, Mode=TwoWay}" />
            <TextBlock Text="{x:Bind SelectedCountText, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <!-- Video Entries List -->
        <ListView Grid.Row="2" ItemsSource="{x:Bind Playlist.Entries, Mode=OneWay}" SelectionMode="None" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="8">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:PlaylistEntry">
                    <Grid ColumnDefinitions="Auto,*" Margin="4,6">
                        <CheckBox Grid.Column="0" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Title}" FontWeight="Medium" FontSize="13" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Uploader}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</ContentDialog>
